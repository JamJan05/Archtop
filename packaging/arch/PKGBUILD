# Maintainer: JamJan05 <janek2ko@gmail.com>
#
# Archtop — GitHub Desktop packaged natively for Arch Linux.
#
# This builds the unmodified upstream application from source. The only
# deviation from desktop/desktop is a thin platform layer that lets the build
# scripts target Linux; see ../../packaging/arch/PORTED-PATCHES.md.

# Release tags of this fork look like v3.6.5-beta1-archtop.2: the upstream
# version being built, then the Archtop revision of it. prepare() builds the
# newest tag matching this glob and pkgver() derives the version from it, so
# cutting a release means pushing a tag — nothing in this file gets edited.
#
# The glob deliberately excludes upstream's own release-* tags, which are on
# this repository too and would otherwise be picked up.
_tagglob='v*-archtop.*'

pkgname=github-desktop-archtop
# Kept in step with the newest tag so .SRCINFO is honest for anything reading
# it without running a build; pkgver() overwrites it at build time. pacman does
# not allow '-' inside pkgver, so the tag's dashes become '_'. See README.md
# for the epoch caveat when 3.6.5 final is packaged.
pkgver=3.6.5_beta1_archtop.3
pkgrel=1
pkgdesc='GitHub Desktop packaged natively for Arch Linux'
arch=('x86_64')
url='https://github.com/JamJan05/Archtop'
license=('MIT')
# Verified against the built binary, not copied from another package:
#   alsa-lib, gtk3, nss  -> NEEDED entries of dist/desktop-linux-x64/desktop
#   libsecret            -> NEEDED entry of resources/app/keytar.node
#   libnotify            -> dlopen'd by Electron (libnotify.so.4/.so.5)
#   git                  -> runtime, invoked as a subprocess
# Everything else objdump reports is reached transitively through gtk3 and nss.
# libxss is deliberately absent: Electron 42 no longer references libXss.
depends=(
  'alsa-lib'
  'git'
  'gtk3'
  'libnotify'
  'libsecret'
  'nss'
)
# git is deliberately absent here: it is already a runtime dependency above, and
# namcap flags the duplication. makepkg still gets it, because depends are
# installed for the build too.
makedepends=(
  'base-devel'
  'nodejs'
  # npm is only an optdepend of Arch's nodejs, but process-proxy's install
  # script runs `npm run build:native`, so a clean chroot build fails without
  # it. Easy to miss locally, where npm is usually already present.
  'npm'
  'python'
  'yarn'
)
optdepends=(
  'gnome-keyring: Secret Service provider for storing GitHub tokens'
  'kwallet: Secret Service provider for storing GitHub tokens (KDE)'
  'openssh: cloning and pushing over SSH'
  'gnupg: GPG commit signing'
  'xdg-utils: registering the x-github-* protocol handlers'
  'qt5-tools: protocol registration under KDE (xdg-mime calls qtpaths; qt6-tools only ships qtpaths6)'
)
# Electron ships prebuilt binaries; stripping them breaks the bundled V8
# snapshots and the debug package would only contain upstream-provided symbols.
options=('!strip' '!debug')
install="$pkgname.install"
# No #branch= or #tag= fragment on purpose. makepkg clones with --mirror, so
# every ref arrives regardless, and prepare() then checks out the newest release
# tag — which branch the clone happens to land on is never read.
#
# A branch pin here used to say unstable-linux on *both* branches: stable-linux
# is the merge of unstable-linux, so the line came across with everything else
# and a PKGBUILD taken from the stable branch quietly built unstable code.
# Keeping the two in step by hand, or by a bot committing onto stable, only
# manages that failure; having nothing to keep in step removes it. The guard in
# .github/workflows/arch-linux.yml fails the build if a pin comes back.
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

# Newest release tag in the clone, by version order rather than by creation
# date or by reachability from any branch. Version order is what matters: a tag
# pushed late for an older release must not outrank a newer one.
_newest_tag() {
  git tag --list "$_tagglob" --sort=-v:refname | head -1
}

prepare() {
  cd "$pkgname"

  local _tag
  _tag=$(_newest_tag)

  if [[ -z $_tag ]]; then
    echo "no tag matching $_tagglob in $url" >&2
    echo "cut a release tag before packaging; see packaging/arch/README.md" >&2
    return 1
  fi

  msg2 "building from $_tag"

  # Detached on purpose: the checkout tracks a release, not a branch, and a
  # rebuild must produce the same tree rather than whatever has landed since.
  git checkout -q --detach "$_tag"
}

pkgver() {
  cd "$pkgname"

  # v3.6.5-beta1-archtop.2 -> 3.6.5_beta1_archtop.2. pacman forbids '-' inside
  # pkgver; '_' preserves the ordering here because the archtop revision is the
  # last component of every tag, so vercmp compares that first where it counts.
  _newest_tag | sed 's/^v//; s/-/_/g'
}

build() {
  cd "$pkgname"

  # makepkg.conf hardens builds with -Wp,-D_FORTIFY_SOURCE=3, but the bundled
  # native helpers (printenvz, process-proxy) pin -D_FORTIFY_SOURCE=1 in their
  # own binding.gyp and compile with -Werror. GCC reports the redefinition and
  # -Werror turns it fatal, so node-gyp fails only under makepkg — a plain
  # `yarn install` never sets the flag. Drop the makepkg-supplied value and let
  # each module keep the level it was written against.
  export CFLAGS="${CFLAGS//-Wp,-D_FORTIFY_SOURCE=[0-9]/}"
  export CXXFLAGS="${CXXFLAGS//-Wp,-D_FORTIFY_SOURCE=[0-9]/}"
  export CPPFLAGS="${CPPFLAGS//-Wp,-D_FORTIFY_SOURCE=[0-9]/}"

  # NOTE: this step requires network access. yarn resolves the dependency tree,
  # downloads the Electron binary and compiles the native modules (keytar needs
  # libsecret headers). A fully offline build() is not achievable here; this is
  # documented as a known limitation in README.md.
  yarn install --frozen-lockfile

  yarn build:prod
}

package() {
  cd "$pkgname"

  # @electron/packager names its output directory after the Node architecture,
  # which is not what CARCH is called. namcap warns that x86_64 below "should be
  # changed to $CARCH"; it cannot tell a case label apart from a hardcoded
  # value. These are the values being matched, so the literals are correct.
  local _distarch
  case "$CARCH" in
    x86_64) _distarch=x64 ;;
    aarch64) _distarch=arm64 ;;
    *) echo "unsupported CARCH: $CARCH" >&2; return 1 ;;
  esac

  local _dist="dist/desktop-linux-$_distarch"
  [[ -d $_dist ]] || { echo "missing build output at $_dist" >&2; return 1; }

  # The upstream executable keeps its own name ('desktop'); /usr/bin holds a
  # thin launcher rather than a second copy of the application.
  install -dm755 "$pkgdir/opt/$pkgname"
  cp -a "$_dist/." "$pkgdir/opt/$pkgname/"

  # @electron/packager emits its output directory as 0700, and `cp -a` faithfully
  # carries that over — including onto the destination directory itself, which is
  # why the install -dm755 above is not enough. Left alone, /opt/<pkg> ends up
  # root-owned and unreadable, so the application installs cleanly and then
  # refuses to start for every non-root user. Capital X keeps the executable bit
  # on directories and on binaries that already had it, without granting it to
  # data files.
  chmod -R u=rwX,go=rX "$pkgdir/opt/$pkgname"

  install -Dm755 "packaging/arch/$pkgname.sh" "$pkgdir/usr/bin/$pkgname"

  install -Dm644 "packaging/arch/$pkgname.desktop" \
    "$pkgdir/usr/share/applications/$pkgname.desktop"

  install -Dm644 app/static/linux/icon-logo.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Electron's setuid sandbox helper is deliberately left non-setuid: Arch
  # enables unprivileged user namespaces, so Chromium uses the namespace
  # sandbox instead. Do not add --no-sandbox to work around this.
  if [[ -f $pkgdir/opt/$pkgname/chrome-sandbox ]]; then
    chmod 755 "$pkgdir/opt/$pkgname/chrome-sandbox"
  fi
}
